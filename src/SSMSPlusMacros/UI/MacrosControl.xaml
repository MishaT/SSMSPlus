<UserControl x:Class="SSMSPlusMacros.UI.MacrosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ext="clr-namespace:SSMSPlusCore.Ui.Extensions;assembly=SSMSPlusCore"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static vs:EnvironmentColors.ToolWindowTextBrushKey}}"
             ext:VsTheme.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="860">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SSMSPlusCore;component/Ui/Design/Forms.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleIfTrue" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12" ext:GridExtensions.Structure="auto,*,auto,auto|*">

        <Grid Grid.Row="0" Margin="0,0,0,12" ext:GridExtensions.Structure="auto,auto|auto,auto,*">
            <Label FontSize="22" Padding="0" Margin="0,0,5,0" VerticalAlignment="Center">SSMS Plus</Label>
            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center">Macros <LineBreak/> one key, several commands</TextBlock>
            <Separator Grid.Row="1" Grid.ColumnSpan="10"></Separator>
        </Grid>

        <Grid Grid.Row="1" ext:GridExtensions.Structure="*|240,16,*">

            <!-- macro list -->
            <Grid ext:GridExtensions.Structure="auto,*,auto|*">
                <Label Style="{StaticResource form_v_Label}">Macros:</Label>
                <ListBox Grid.Row="1" ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3" ext:GridExtensions.Structure="auto|*,auto">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="8,0,0,0" Opacity="0.7" Text="{Binding Shortcut}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Command="{Binding AddMacroCmd}" Padding="10,3" Margin="0,0,6,0">Add</Button>
                    <Button Command="{Binding DeleteMacroCmd}" Padding="10,3" IsEnabled="{Binding HasSelection}">Delete</Button>
                </StackPanel>
            </Grid>

            <!-- selected macro -->
            <Grid Grid.Column="2" IsEnabled="{Binding HasSelection}" ext:GridExtensions.Structure="auto,auto,auto,auto,auto,auto,auto,auto,*,auto,auto,auto|*">
                <Label Grid.Row="0" Style="{StaticResource form_v_Label}">Name:</Label>
                <TextBox Grid.Row="1" Height="26" Padding="4" Margin="0,0,0,10" Text="{Binding SelectedMacro.Name, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2" Style="{StaticResource form_v_Label}">Shortcut:</Label>
                <Grid Grid.Row="3" ext:GridExtensions.Structure="auto|*,auto">
                    <TextBox x:Name="ShortcutBox" Height="26" Padding="4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                             Text="{Binding SelectedMacro.Shortcut, Mode=OneWay}"
                             PreviewKeyDown="ShortcutBox_PreviewKeyDown"
                             ToolTip="Click here and press the keys, e.g. F6 or Ctrl+Shift+E. Backspace clears." />
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,3" Command="{Binding ClearShortcutCmd}">Clear</Button>
                </Grid>
                <TextBlock Grid.Row="4" Margin="0,3,0,10" Opacity="0.7" TextWrapping="Wrap"
                           Text="Click the box and press the keys. A key used by an SSMS command is taken from it, and given back when no macro uses it." />

                <Label Grid.Row="5" Style="{StaticResource form_v_Label}">Shortcut active in:</Label>
                <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,2,0,10">
                    <RadioButton GroupName="Scope" Margin="0,0,16,0" IsChecked="{Binding SelectedMacro.IsQueryEditor}">Query windows</RadioButton>
                    <RadioButton GroupName="Scope" IsChecked="{Binding SelectedMacro.IsGlobal}">Everywhere</RadioButton>
                </StackPanel>

                <Label Grid.Row="7" Style="{StaticResource form_v_Label}">Commands, run in this order:</Label>
                <Grid Grid.Row="8" ext:GridExtensions.Structure="*|*,auto">
                    <ListBox ItemsSource="{Binding SelectedMacro.Commands}" SelectedIndex="{Binding SelectedMacro.SelectedCommandIndex}" />
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <Button Command="{Binding MoveUpCmd}" Padding="10,3" Margin="0,0,0,6">Up</Button>
                        <Button Command="{Binding MoveDownCmd}" Padding="10,3" Margin="0,0,0,6">Down</Button>
                        <Button Command="{Binding RemoveCommandCmd}" Padding="10,3">Remove</Button>
                    </StackPanel>
                </Grid>

                <Label Grid.Row="9" Margin="0,10,0,0" Style="{StaticResource form_v_Label}">Add a command (search, then double click or Add):</Label>
                <Grid Grid.Row="10" ext:GridExtensions.Structure="auto|*,auto">
                    <TextBox Height="26" Padding="4" Text="{Binding CommandSearch, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Part of an SSMS command name, e.g. ResultsTo or Query.Execute">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddCommandCmd}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,3" Command="{Binding AddCommandCmd}">Add command</Button>
                </Grid>
                <ListBox Grid.Row="11" Height="110" Margin="0,4,0,0"
                         ItemsSource="{Binding MatchingCommands}" SelectedItem="{Binding SelectedMatchingCommand}"
                         MouseDoubleClick="MatchingCommands_MouseDoubleClick" />
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Text="{Binding Message}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Foreground" Value="#FFE05A5A" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Grid.Row="3" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding SaveCmd}" Padding="16,4" Margin="0,0,8,0" IsDefault="False">Save</Button>
            <Button Padding="16,4" IsCancel="True" Click="Close_Click">Close</Button>
        </StackPanel>
    </Grid>
</UserControl>
